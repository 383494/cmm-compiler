struct Point {
  int x, y;
};

int data[4];

int sum(int values[4], int count) {
  int i = 0;
  int total = 0;
  while (i < count) {
    total = total + values[i];
    i = i + 1;
  }
  return total;
}

int main() {
  struct Point p;
  int local[4];
  p.x = 1;
  p.y = 2;
  local[0] = p.x;
  local[1] = p.y;
  local[2] = -3;
  local[3] = 4;
  if (!(p.x == 0 || p.y < 0)) {
    local[0] = sum(local, 4);
  } else {
    local[0] = 0;
  }
  while (p.x < 10) {
    p.x = p.x + 1;
  }
  return local[0];
}
