struct S {
  int a, b;
};

int global;

int helper(int n) {
  int acc = 0;
  while (n > 0) {
    acc = acc + n;
    n = n - 1;
  }
  return acc;
}

int main() {
  struct S s;
  int a[3];
  int i = 0;
  s.a = 1
  s.b = 2;
  a[0] = helper(s.a);
  a[1] = helper(s.b);
  a[2] = a[0] + a[1];
  while (i < 3) {
    i = i + 1;
  }
  if (a[0] > a[1]) {
    return a[0];
  } else {
    return a[1];
  }
}
